<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ZaiWrapper" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorPrimary">@color/deep_blue</item>
        <item name="colorOnPrimary">@color/neon_yellow</item>
        <item name="colorSecondary">@color/emerald_green</item>
        <item name="colorOnSecondary">@color/amoled_black</item>
        <item name="colorError">@color/crimson_red</item>
        <item name="colorOnError">@color/white</item>

        <item name="colorSurface">@color/dark_surface</item>
        <item name="android:colorBackground">@color/amoled_black</item>
    </style>

    <style name="Theme.ZaiWrapper.Splash" parent="Theme.ZaiWrapper">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>
